{
  "name": "lineup-coach-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "benchmark": "node --import tsx tests/benchmark.ts",
    "test:offline": "node --test tests/offline.test.mjs",
    "verify": "npm run build && npm test && npm run test:offline"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@mui/material": "^7.3.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "dexie": "^4.0.11",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.13",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.20.0",
    "fake-indexeddb": "^6.0.0"
  }
}
